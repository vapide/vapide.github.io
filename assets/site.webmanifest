---
layout: null
sitemap: false
---
{
  "name": "{{ site.author.name }}",
  "short_name": "{{ site.author.name | split: ' ' | first }}",
  "icons": [
    { "src": "{{ '/assets/android-chrome-192x192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/android-chrome-512x512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" }
  ],
  "theme_color": "#09090b",
  "background_color": "#09090b",
  "display": "standalone",
  "start_url": "{{ '/' | relative_url }}"
}
